//- Avoids including Bootstrap's own JS to prevent conflicts with react-bootstrap,
//- since Bootstrap 5's JS and react-bootstrap should not be used together on the same page.
extends ./layout-base

include ./_mixins/formMessages

block isApplicationPageVar
	- isApplicationPage = true

block append meta
	- const canDisplayAdminMenu = false
	- const canDisplayAdminRedirect = false
	- const sessionUser = undefined
	- const canDisplayProjectUrlLookup = false
	- const canDisplaySplitTestMenu = false
	- const canDisplaySurveyMenu = false
	- const canDisplayScriptLogMenu = false
	- const enableUpgradeButton = false
	- const showSignUpLink = false

	meta(
		name='ol-navbar'
		data-type='json'
		content={
			customLogo: settings.nav.custom_logo_light || settings.nav.custom_logo,
			customLogoDark: settings.nav.custom_logo_dark || settings.nav.custom_logo,
			title: nav.title,
			canDisplayAdminMenu: false,
			canDisplayAdminRedirect: false,
			canDisplayProjectUrlLookup: false,
			canDisplaySplitTestMenu: false,
			canDisplaySurveyMenu: false,
			canDisplayScriptLogMenu: false,
			enableUpgradeButton: false,
			suppressNavbarRight: true,
			suppressNavContentLinks: !!suppressNavContentLinks,
			showSubscriptionLink: false,
			showSignUpLink: false,
			currentUrl: currentUrl,
			sessionUser: undefined,
			adminUrl: undefined,
			items: [],
		}
	)
	meta(
		name='ol-footer'
		data-type='json'
		content={
			showThinFooter: showThinFooter,
			showPoweredBy: !hasFeature('saas') && !settings.nav.hide_powered_by,
			subdomainLang: settings.i18n.subdomainLang,
			translatedLanguages: settings.translatedLanguages,
			leftItems: cloneAndTranslateText(settings.nav.left_footer),
			rightItems: settings.nav.right_footer,
		}
	)

block body
	if typeof suppressNavbar === 'undefined'
		include layout/navbar-marketing-react

	block content

	if typeof suppressFooter === 'undefined'
		if showThinFooter
			include layout/thin-footer
		else
			include layout/fat-footer-react

	if typeof suppressPugCookieBanner === 'undefined'
		include _cookie_banner
