**/.yarn/build-state/
.yarn/install-state.gz
**/.yarn/install-state.gz
.pnp.*
**/.pnp.*
.npm/
**/.npm/
.cache/
**/.cache/

# Large Archives & Engine Payloads (Distribute via GitHub Releases, NOT Git)
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.iso
*.vhdx
*.vmdk
*.7z
**/*.zip

